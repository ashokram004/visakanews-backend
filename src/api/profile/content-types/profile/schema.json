{
  "kind": "collectionType",
  "collectionName": "profiles",
  "info": {
    "singularName": "profile",
    "pluralName": "profiles",
    "displayName": "Profile"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "profileType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "POLITICIAN",
        "ACTOR",
        "SPORTSPERSON",
        "CELEBRITY"
      ]
    },
    "profileImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "shortBio": {
      "type": "text",
      "required": true
    },
    "homeVideo": {
      "type": "string"
    },
    "detailedBio": {
      "type": "blocks"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "profiles"
    },
    "videos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::video.video",
      "inversedBy": "profiles"
    },
    "profileAchievements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::profile-achievement.profile-achievement",
      "mappedBy": "profile"
    }
  }
}
