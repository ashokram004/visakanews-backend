{
  "kind": "collectionType",
  "collectionName": "dynamic_tabs",
  "info": {
    "singularName": "dynamic-tab",
    "pluralName": "dynamic-tabs",
    "displayName": "DynamicTab"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "dynamicTabs"
    },
    "highlighted": {
      "type": "boolean",
      "default": true
    }
  }
}
