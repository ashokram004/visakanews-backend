{
  "kind": "collectionType",
  "collectionName": "advertisements",
  "info": {
    "singularName": "advertisement",
    "pluralName": "advertisements",
    "displayName": "Advertisement"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "link": {
      "type": "string"
    },
    "position": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "headerAd",
        "leftHomeAd",
        "rightHomeAd",
        "articleAd"
      ]
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": true
    }
  }
}
